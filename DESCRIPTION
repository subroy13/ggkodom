Package: ggkodom
Title: Visualize Individual Longitudinal Trajectories
Version: 1.0.0
Authors@R: c(
    person("Ayoushman", "Bhattacharya", role = "aut"),
    person("Sayan", "Das", role = "aut"),
    person("Subrata", "Pal", role = "aut"),
    person("Subhrajyoty", "Roy", , "subhrajyotyroy@gmail.com", role = c("aut", "cre"))
