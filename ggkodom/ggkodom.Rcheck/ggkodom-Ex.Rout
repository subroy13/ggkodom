> ### Name: kodom_fit
> ### Title: Visualize a fitted longitudinal model as a kodom-swimlane
> ### Aliases: kodom_fit kodom_fit.lmerMod kodom_fit.glmerMod kodom_fit.gam
> ###   kodom_fit.fpca kodom_fit.fpca.sc kodom_fit.FPCA
> 
> ### ** Examples
> 
> ## Not run: 
> ##D   # lme4
> ##D   set.seed(1)
> ##D   df <- data.frame(
> ##D     id   = factor(rep(1:30, each = 6)),
> ##D     time = rep(seq(0, 5, length.out = 6), 30)
> ##D   )
> ##D   df$y <- 5 + 0.3 * df$time +
> ##D           rnorm(30, 0, 0.6)[df$id] +
> ##D           rnorm(30, 0, 0.2)[df$id] * df$time +
> ##D           rnorm(nrow(df), 0, 0.5)
> ##D   m <- lme4::lmer(y ~ time + (1 + time | id), data = df)
> ##D   kodom_fit(m, id = "id", time = "time")
> ##D 
> ##D   # mgcv hierarchical GAM (one smooth per subject)
> ##D   g <- mgcv::gam(y ~ s(time, id, bs = "fs", k = 4), data = df)
> ##D   kodom_fit(g, id = "id", time = "time")
> ## End(Not run)
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
