> ### Name: kodom_state
> ### Title: State-ribbon trajectory plot
> ### Aliases: kodom_state
> 
> ### ** Examples
> 
> set.seed(42)
> df <- data.frame(
+   id    = rep(1:20, each = 5),
+   time  = rep(seq(0, 120, 30), 20),
+   value = rnorm(100, 7, 1.5)
+ )
> kodom_state(df, thresholds = c(6.5, 8))
> 
