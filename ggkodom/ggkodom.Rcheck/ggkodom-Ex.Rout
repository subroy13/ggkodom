> ### Name: kodom_state
> ### Title: State-ribbon trajectory plot
> ### Aliases: kodom_state
> 
> ### ** Examples
> 
> set.seed(42)
> n_subj <- 20; n_obs <- 5
> df <- data.frame(
+   id    = rep(seq_len(n_subj), each = n_obs),
+   time  = as.vector(replicate(n_subj, sort(round(runif(n_obs, 0, 120))))),
+   value = rnorm(n_subj * n_obs, 7, 1.5)
+ )
> kodom_state(df, thresholds = c(6.5, 8))
> 
