> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: kodom_swimlane
> ### Title: Swimlane trajectory plot
> ### Aliases: kodom_swimlane
> 
> ### ** Examples
> 
> set.seed(42)
> df <- data.frame(
+   id    = rep(1:20, each = 5),
+   time  = rep(seq(0, 120, 30), 20),
+   value = rnorm(100, 7, 1.5)
+ )
> 
> ## classic swimlane
> kodom_swimlane(df, color_breaks = c(5, 7, 10))
> 
> ## heatmap variant
> kodom_swimlane(df, geom = "tile", time_bins = 7)
> 
> ## circular variant
> kodom_swimlane(df, coord = "polar")
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
> base::cat("kodom_swimlane", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
