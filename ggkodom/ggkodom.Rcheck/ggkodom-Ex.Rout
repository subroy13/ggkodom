> ### Name: kodom_swimlane
> ### Title: Swimlane trajectory plot
> ### Aliases: kodom_swimlane
> 
> ### ** Examples
> 
> set.seed(42)
> df <- data.frame(
+   id    = rep(1:20, each = 5),
+   time  = rep(seq(0, 120, 30), 20),
+   value = rnorm(100, 7, 1.5)
+ )
> kodom_swimlane(df)
> 
> # With color anchored at clinical thresholds
> kodom_swimlane(df, color_breaks = c(5, 7, 10))
